{
  "name": "blockr.graph",
  "private": true,
  "description": "Builds and checks the client of blockr.graph: TypeScript in srcts/, bundled into inst/js.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "scripts": {
    "pretypecheck": "Rscript -e 'blockr.core::install_js_types()'",
    "typecheck": "tsc -b",
    "prelint": "Rscript -e 'blockr.core::install_js_types()'",
    "lint": "eslint .",
    "pretest": "Rscript -e 'blockr.core::install_js_types()'",
    "test": "vitest run",
    "prebuild": "Rscript -e 'blockr.core::install_js_types()'",
    "build": "node srcts/build/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
